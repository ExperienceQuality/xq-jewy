{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "xq-jewy (http)",
      "type": "debugpy",
      "request": "launch",
      "module": "xq_jewy",
      "args": ["--transport", "http", "--log-level", "DEBUG"],
      "console": "integratedTerminal"
    },
    {
      "name": "pytest (current file)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "--no-cov"],
      "console": "integratedTerminal"
    }
  ]
}
