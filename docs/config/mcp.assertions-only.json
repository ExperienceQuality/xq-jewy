{
  "mcpServers": {
    "xq-jewy": {
      "command": "node",
      "args": ["/absolute/path/to/xq-jewy/dist/index.js"],
      "env": {
        "XQ_JEWY_CONFIG": "/absolute/path/to/xq.yaml",
        "XQ_JEWY_API_BASE_URL": "http://127.0.0.1:8080",
        "XQ_JEWY_WIREMOCK_BASE_URL": "http://127.0.0.1:8081"
      }
    }
  }
}
