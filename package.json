{
  "name": "xq-jewy",
  "version": "0.1.0",
  "description": "A beginner-friendly MCP server boilerplate: TypeScript, pnpm, Biome, Vitest and FastMCP.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "xq-jewy": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts --transport http --log-level debug",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm coverage",
    "inspect": "fastmcp inspect src/main.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "fastmcp": "^4.23.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
